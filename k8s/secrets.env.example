# Plantilla del Secret biblioteca-secrets. NO está en kustomization.yaml a propósito:
# si Argo CD lo gestionara, pisaría las contraseñas reales con estos valores.
# Crear/rotar a mano:
#   kubectl -n biblioteca create secret generic biblioteca-secrets \
#     --from-literal=AMULE_GUI_PWD="$(openssl rand -hex 16)" \
#     --from-literal=AMULE_WEBUI_PWD="$(openssl rand -hex 16)"
AMULE_GUI_PWD=CAMBIAR
AMULE_WEBUI_PWD=CAMBIAR
